# Auto detect text files and perform LF normalization
* text=auto

# Source code and documentation
*.py text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.pkl binary
*.npy binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
